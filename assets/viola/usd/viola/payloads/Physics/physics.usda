    over "Physics"
    {
        def PhysicsRevoluteJoint "joint1" (
            prepend apiSchemas = ["PhysicsDriveAPI:angular", "PhysicsJointStateAPI:angular"]
        )
        {
            float drive:angular:physics:damping = 0.019355701
            float drive:angular:physics:maxForce = 100
            float drive:angular:physics:stiffness = 0.30717796
            uniform token drive:angular:physics:type = "force"
            uniform token physics:axis = "Z"
            custom rel physics:body0
            prepend rel physics:body0 = </viola_description/Geometry/world/base_link>
            custom rel physics:body1
            prepend rel physics:body1 = </viola_description/Geometry/world/base_link/link1>
            point3f physics:localPos0 = (0, 0, 0.06575)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (0, -1, 0, 0)
            quatf physics:localRot1 = (0, -1, 0, 0)
            float physics:lowerLimit = -130.06142
            float physics:upperLimit = 130.06142
            custom float urdf:limit:effort = 100
            custom float urdf:limit:velocity = 1
        }

        def PhysicsRevoluteJoint "joint2" (
