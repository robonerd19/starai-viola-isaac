                                            float3 physics:diagonalInertia = (6.4035095e-7, 0.0000014232518, 0.0000017598537)
                                            float physics:mass = 0.009364076
                                            quatf physics:principalAxes = (-0.06590798, 0.7040149, 0.70404047, -0.06592562)
                                        }

                                        over "link7_right" (
                                            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
                                        )
