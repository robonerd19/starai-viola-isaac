#usda 1.0
(
    customLayerData = {
        string creator = "URDF USD Converter v0.1.3"
    }
    defaultPrim = "viola_description"
    kilogramsPerUnit = 1
    metersPerUnit = 1
    upAxis = "Z"
)

over "viola_description"
{
    over "Geometry"
    {
        over "world" (
            prepend apiSchemas = ["PhysicsArticulationRootAPI", "NewtonArticulationRootAPI"]
        )
        {
            bool newton:selfCollisionEnabled = 0

            over "base_link" (
                prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
            )
            {
                point3f physics:centerOfMass = (-0.03660244, 1.0267452e-7, 0.015277318)
                float3 physics:diagonalInertia = (0.00028465985, 0.0007999662, 0.000969513)
