        def PhysicsFixedJoint "world_to_base"
        {
            custom rel physics:body0
            prepend rel physics:body0 = </viola_description>
            custom rel physics:body1
            prepend rel physics:body1 = </viola_description/Geometry/world/base_link>
            point3f physics:localPos0 = (0, 0, 0)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
